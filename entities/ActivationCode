{
  "name": "ActivationCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The activation code string"
    },
    "target_email": {
      "type": "string",
      "description": "Email of the user this code is for"
    },
    "is_used": {
      "type": "boolean",
      "default": false,
      "description": "Whether this code has been used"
    },
    "used_by": {
      "type": "string",
      "description": "Email of user who used the code"
    },
    "used_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the code was used"
    }
  },
  "required": [
    "code",
    "target_email"
  ]
}